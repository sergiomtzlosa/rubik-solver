program(1.0)
[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.12.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios17>(tensor<fp32, [512, 324]> cube_state) {
            tensor<string, []> cube_state_to_fp16_dtype_0 = const()[name = tensor<string, []>("cube_state_to_fp16_dtype_0"), val = tensor<string, []>("fp16")];
            tensor<fp16, [1024, 324]> input_layer_weight_to_fp16 = const()[name = tensor<string, []>("input_layer_weight_to_fp16"), val = tensor<fp16, [1024, 324]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(64)))];
            tensor<fp16, [1024]> input_layer_bias_to_fp16 = const()[name = tensor<string, []>("input_layer_bias_to_fp16"), val = tensor<fp16, [1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(663680)))];
            tensor<fp16, [512, 324]> cube_state_to_fp16 = cast(dtype = cube_state_to_fp16_dtype_0, x = cube_state)[name = tensor<string, []>("cast_2")];
            tensor<fp16, [512, 1024]> linear_0_cast_fp16 = linear(bias = input_layer_bias_to_fp16, weight = input_layer_weight_to_fp16, x = cube_state_to_fp16)[name = tensor<string, []>("linear_0_cast_fp16")];
            tensor<fp16, [512, 1024]> input_3_cast_fp16 = relu(x = linear_0_cast_fp16)[name = tensor<string, []>("input_3_cast_fp16")];
            tensor<fp16, [1024, 1024]> res_block1_fc1_weight_to_fp16 = const()[name = tensor<string, []>("res_block1_fc1_weight_to_fp16"), val = tensor<fp16, [1024, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(665792)))];
            tensor<fp16, [1024]> res_block1_fc1_bias_to_fp16 = const()[name = tensor<string, []>("res_block1_fc1_bias_to_fp16"), val = tensor<fp16, [1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2763008)))];
            tensor<fp16, [512, 1024]> linear_1_cast_fp16 = linear(bias = res_block1_fc1_bias_to_fp16, weight = res_block1_fc1_weight_to_fp16, x = input_3_cast_fp16)[name = tensor<string, []>("linear_1_cast_fp16")];
            tensor<fp16, [512, 1024]> input_7_cast_fp16 = relu(x = linear_1_cast_fp16)[name = tensor<string, []>("input_7_cast_fp16")];
            tensor<fp16, [1024, 1024]> res_block1_fc2_weight_to_fp16 = const()[name = tensor<string, []>("res_block1_fc2_weight_to_fp16"), val = tensor<fp16, [1024, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2765120)))];
            tensor<fp16, [1024]> res_block1_fc2_bias_to_fp16 = const()[name = tensor<string, []>("res_block1_fc2_bias_to_fp16"), val = tensor<fp16, [1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(4862336)))];
            tensor<fp16, [512, 1024]> linear_2_cast_fp16 = linear(bias = res_block1_fc2_bias_to_fp16, weight = res_block1_fc2_weight_to_fp16, x = input_7_cast_fp16)[name = tensor<string, []>("linear_2_cast_fp16")];
            tensor<fp16, [512, 1024]> input_9_cast_fp16 = add(x = input_3_cast_fp16, y = linear_2_cast_fp16)[name = tensor<string, []>("input_9_cast_fp16")];
            tensor<fp16, [512, 1024]> input_11_cast_fp16 = relu(x = input_9_cast_fp16)[name = tensor<string, []>("input_11_cast_fp16")];
            tensor<fp16, [1024, 1024]> res_block2_fc1_weight_to_fp16 = const()[name = tensor<string, []>("res_block2_fc1_weight_to_fp16"), val = tensor<fp16, [1024, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(4864448)))];
            tensor<fp16, [1024]> res_block2_fc1_bias_to_fp16 = const()[name = tensor<string, []>("res_block2_fc1_bias_to_fp16"), val = tensor<fp16, [1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(6961664)))];
            tensor<fp16, [512, 1024]> linear_3_cast_fp16 = linear(bias = res_block2_fc1_bias_to_fp16, weight = res_block2_fc1_weight_to_fp16, x = input_11_cast_fp16)[name = tensor<string, []>("linear_3_cast_fp16")];
            tensor<fp16, [512, 1024]> input_15_cast_fp16 = relu(x = linear_3_cast_fp16)[name = tensor<string, []>("input_15_cast_fp16")];
            tensor<fp16, [1024, 1024]> res_block2_fc2_weight_to_fp16 = const()[name = tensor<string, []>("res_block2_fc2_weight_to_fp16"), val = tensor<fp16, [1024, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(6963776)))];
            tensor<fp16, [1024]> res_block2_fc2_bias_to_fp16 = const()[name = tensor<string, []>("res_block2_fc2_bias_to_fp16"), val = tensor<fp16, [1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(9060992)))];
            tensor<fp16, [512, 1024]> linear_4_cast_fp16 = linear(bias = res_block2_fc2_bias_to_fp16, weight = res_block2_fc2_weight_to_fp16, x = input_15_cast_fp16)[name = tensor<string, []>("linear_4_cast_fp16")];
            tensor<fp16, [512, 1024]> input_17_cast_fp16 = add(x = input_11_cast_fp16, y = linear_4_cast_fp16)[name = tensor<string, []>("input_17_cast_fp16")];
            tensor<fp16, [512, 1024]> input_cast_fp16 = relu(x = input_17_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [1, 1024]> value_head_weight_to_fp16 = const()[name = tensor<string, []>("value_head_weight_to_fp16"), val = tensor<fp16, [1, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(9063104)))];
            tensor<fp16, [1]> value_head_bias_to_fp16 = const()[name = tensor<string, []>("value_head_bias_to_fp16"), val = tensor<fp16, [1]>([0x1.8a4p-5])];
            tensor<fp16, [512, 1]> value = linear(bias = value_head_bias_to_fp16, weight = value_head_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_5_cast_fp16")];
            tensor<fp16, [18, 1024]> policy_head_weight_to_fp16 = const()[name = tensor<string, []>("policy_head_weight_to_fp16"), val = tensor<fp16, [18, 1024]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(9065216)))];
            tensor<fp16, [18]> policy_head_bias_to_fp16 = const()[name = tensor<string, []>("policy_head_bias_to_fp16"), val = tensor<fp16, [18]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(9102144)))];
            tensor<fp16, [512, 18]> policy = linear(bias = policy_head_bias_to_fp16, weight = policy_head_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_6_cast_fp16")];
        } -> (value, policy);
}